# Regeln für den Betrieb in einem Unterordner von praesenzwert.de.
# /grillparty wird beim Build durch den tatsächlichen Pfad ersetzt.
#
# WICHTIG: mod_rewrite-Regeln werden von Apache NICHT aus dem übergeordneten
# Verzeichnis geerbt. Sobald hier "RewriteEngine On" steht, gelten für diesen
# Ordner ausschließlich die folgenden Regeln - die SPA-Weiterleitung der
# Hauptseite greift hier also nicht mehr hinein. Genau so ist es gewollt.
#
# Header (HTTPS-Zwang, CSP, HSTS) werden dagegen sehr wohl geerbt und bleiben
# deshalb bewusst unangetastet, damit sich hier nichts mit der Hauptseite beißt.

Options -Indexes

RewriteEngine On
RewriteBase /grillparty/

# --- Datenspeicher komplett sperren ---------------------------------------
# Die JSON-Dateien enthalten Namen und E-Mail-Adressen der Gäste.
RewriteRule ^_data(/|$) - [F,L]

# --- Vorhandene Dateien und Verzeichnisse direkt ausliefern ----------------
# Damit sind /api/*.php, /p/ und /rad/ abgedeckt.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# --- Kurzlink: /grillparty/dennis  ->  /grillparty/p/index.html?e=dennis ---------
RewriteRule ^([a-z0-9][a-z0-9-]{1,39})/?$ /grillparty/p/index.html?e=$1 [L,QSA]

# --- Alles Übrige auf die Startseite der App ------------------------------
RewriteRule ^ /grillparty/index.html [L,QSA]

# --- HTML nie cachen, sonst zeigen Gäste veraltete Stände ------------------
<IfModule mod_headers.c>
    <FilesMatch "\.(html|php)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
