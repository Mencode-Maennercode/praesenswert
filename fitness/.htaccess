# Regeln für den Betrieb in einem Unterordner von praesenzwert.de.
# /fitness wird beim Build durch den tatsächlichen Pfad ersetzt.
#
# WICHTIG: mod_rewrite-Regeln werden von Apache NICHT aus dem übergeordneten
# Verzeichnis geerbt. Sobald hier "RewriteEngine On" steht, gelten für diesen
# Ordner ausschließlich die folgenden Regeln - die SPA-Weiterleitung der
# Hauptseite greift hier also nicht mehr hinein. Genau so ist es gewollt.
#
# Header dagegen WERDEN geerbt. Und genau das ist hier das Problem, siehe unten.

Options -Indexes

RewriteEngine On
RewriteBase /fitness/

# --- Datenspeicher komplett sperren ---------------------------------------
# Hier liegen Konten, Passwort-Hashes, Tageseinträge, der VAPID-Schlüssel und
# die API-Schlüssel. Ein zweiter Riegel steht in _data/.htaccess.
RewriteRule ^_data(/|$) - [F,L]

# --- Vorhandene Dateien und Verzeichnisse direkt ausliefern ----------------
# Damit sind /api/*.php, /liste/ und /datenschutz/ abgedeckt.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# --- Alles Übrige auf die Startseite der App ------------------------------
RewriteRule ^ /fitness/index.html [L,QSA]

<IfModule mod_expires.c>
    # Die Wurzel-.htaccess setzt für JavaScript "access plus 1 month". Das
    # würde auch sw.js einfrieren - eine neue App-Version käme dann bis zu
    # vier Wochen lang bei niemandem an. Die Steuerung wird deshalb hier
    # komplett übernommen und unten explizit gesetzt.
    ExpiresActive Off
</IfModule>

<IfModule mod_headers.c>
    # ------------------------------------------------------------------
    # Die wichtigste Zeile der ganzen Datei.
    #
    # Die Wurzel-.htaccess setzt:
    #     Permissions-Policy "camera=(), microphone=(), geolocation=()"
    # Leere Klammern heißen "für niemanden, auch nicht für die eigene Seite".
    # Header werden in Unterverzeichnisse vererbt, also gälte das auch hier.
    #
    # Der Fehler wäre heimtückisch: Der Browser meldet nichts. getUserMedia
    # wirft NotAllowedError - dasselbe, was auch bei einer Ablehnung durch
    # den Nutzer kommt - und enumerateDevices liefert eine leere Liste. Man
    # sucht den Fehler garantiert im JavaScript.
    #
    # Prüfen mit:  curl -I https://praesenzwert.de/fitness/
    # Erwartet:    Permissions-Policy: camera=(self), microphone=(self), ...
    # ------------------------------------------------------------------
    Header set Permissions-Policy "camera=(self), microphone=(self), geolocation=()"

    # Private App - gehört in keinen Suchindex.
    Header set X-Robots-Tag "noindex, nofollow"

    # Gehashte Build-Dateien aus _next/ dürfen dauerhaft liegen bleiben.
    <FilesMatch "\.(js|css|woff2?)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # Medien wechseln selten, aber nicht nie - deshalb kein "immutable".
    <FilesMatch "\.(png|jpe?g|webp|avif|svg|ico|mp4|webm)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>

    # HTML und API-Antworten nie cachen, sonst sieht man veraltete Stände.
    <FilesMatch "\.(html|php|json)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>

    # Der Service Worker muss bei jedem Start neu geprüft werden - sonst
    # bleibt eine alte App-Version hängen. Diese Regel steht bewusst NACH
    # der .js-Regel oben, denn bei "Header set" gewinnt die letzte.
    <Files "sw.js">
        Header set Cache-Control "no-cache, must-revalidate"
        # Erlaubt dem Worker, den ganzen Unterordner zu steuern.
        Header set Service-Worker-Allowed "/fitness/"
    </Files>
    <Files "manifest.json">
        Header set Cache-Control "no-cache, must-revalidate"
    </Files>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
